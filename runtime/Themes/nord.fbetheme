{
  "format": "FictionBookEditorNext.CodeTheme",
  "formatVersion": 1,
  "id": "nord",
  "name": "Nord",
  "isDark": true,
  "colors": {
    "editor.background": "#2E3440",
    "editor.foreground": "#D8DEE9",
    "editor.selection.background": "#434C5E",
    "editor.selection.foreground": "#ECEFF4",
    "editor.currentLine.background": "#3B4252",
    "editor.caret": "#D8DEE9",
    "editor.lineNumber": "#4C566A",
    "editor.lineNumber.active": "#D8DEE9",
    "editor.matchingTag.background": "#434C5E",
    "editor.matchingTag.border": "#88C0D0",
    "xml.text": "#D8DEE9",
    "xml.tag.name": "#81A1C1",
    "xml.tag.delimiter": "#616E88",
    "xml.attribute.name": "#8FBCBB",
    "xml.attribute.value": "#A3BE8C",
    "xml.namespace": "#88C0D0",
    "xml.comment": "#616E88",
    "xml.entity": "#D08770",
    "xml.cdata": "#B48EAD",
    "xml.processingInstruction": "#B48EAD",
    "xml.doctype": "#B48EAD",
    "xml.error": "#BF616A",
    "xml.warning": "#EBCB8B"
  }
}
