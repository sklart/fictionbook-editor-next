<html>
<head>
 <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
 <title>FB2 Recode</title>
 <style>body{font-family:Tahoma,Arial,sans-serif;margin:16px}#report{height:330px;border:1px solid #999;overflow:auto;white-space:pre-wrap;padding:6px}.ok{color:#176b2c}.warn{color:#805b00}.err{color:#a60000}.row{margin:8px 0}</style>
 <script src="fb2recode.js"></script>
 <script>
 var cancelled=false, running=false, reportDiv;
 function getFolder(){var shell=new ActiveXObject("Shell.Application"),f=shell.BrowseForFolder(0,"Выберите папку",16,0);return f?f.Items().Item().Path:"";}
 function getFile(){var shell=new ActiveXObject("UserAccounts.CommonDialog");shell.Filter="FB2 files|*.fb2";shell.FilterIndex=1;if(shell.ShowOpen())return shell.FileName;return "";}
 function line(text,kind){var d=document.createElement("div");d.className=kind||"";d.appendChild(document.createTextNode(text));reportDiv.appendChild(d);reportDiv.scrollTop=reportDiv.scrollHeight;}
 function clearReport(){while(reportDiv.firstChild)reportDiv.removeChild(reportDiv.firstChild);}
 function value(id){return document.getElementById(id).value;}
 function finishBatch(){running=false;document.getElementById("start").disabled=false;document.getElementById("cancel").disabled=true;document.getElementById("current").innerText="";}
 function process(){var input=value("path"),opt,files,index=0,errorIndex,enumerationError,stats={found:0,same:0,converted:0,skipped:0,errors:0},button=document.getElementById("start");if(running)return;if(!input){line("Выберите файл или папку.","err");return;}running=true;cancelled=false;button.disabled=true;document.getElementById("cancel").disabled=false;clearReport();opt={encoding:value("encoding"),recursive:document.getElementById("recursive").checked,backup:document.getElementById("backup").checked,overwrite:document.getElementById("overwrite").checked,dryRun:document.getElementById("dryrun").checked,force:document.getElementById("force").checked};try{files=FB2Recode.collectFiles([input],opt.recursive);stats.found=files.length;for(errorIndex=0;errorIndex<files.errors.length;errorIndex++){enumerationError=files.errors[errorIndex];stats.errors++;line("error: "+enumerationError.path+" — "+enumerationError.stage+": "+enumerationError.message,"err");}line("Начинаем обработку…");}catch(e){line("Критическая ошибка: "+e.message,"err");finishBatch();return;}function next(){var item;if(cancelled||index>=files.length){if(cancelled)stats.skipped+=files.length-index;line("Найдено: "+stats.found+"; уже соответствуют: "+stats.same+"; преобразовано: "+stats.converted+"; пропущено: "+stats.skipped+"; ошибок: "+stats.errors+(cancelled?"; отменено пользователем":"")+(opt.dryRun?" (проверка без записи)":""),stats.errors?"err":"ok");finishBatch();return;}document.getElementById("current").innerText="["+(index+1)+"/"+files.length+"] "+files[index];item=FB2Recode.processFile(files[index++],opt);stats[item.status==="same"?"same":item.status==="converted"?"converted":"errors"]++;line(item.status+": "+item.path+(item.message?" — "+item.stage+": "+item.message:""),item.status==="error"?"err":item.status==="same"?"warn":"ok");setTimeout(next,0);}setTimeout(next,0);}
 function copyReport(){window.clipboardData.setData("Text",reportDiv.innerText);}
 function saveReport(){var p=prompt("Файл отчёта:","fb2recode-report.txt"),s,i;if(!p)return;s=new ActiveXObject("Scripting.FileSystemObject").CreateTextFile(p,true,true);s.Write(reportDiv.innerText);s.Close();}
 function init(){reportDiv=document.getElementById("report");try{document.getElementById("path").value=new ActiveXObject("WScript.Shell").RegRead("HKCU\\Software\\FB2Recode\\LastPath");}catch(e){}}
 function chooseFolder(){var p=getFolder();if(p){document.getElementById("path").value=p;try{new ActiveXObject("WScript.Shell").RegWrite("HKCU\\Software\\FB2Recode\\LastPath",p,"REG_SZ");}catch(e){}}}
 </script>
</head>
<body onload="init()"><h2>FB2 Recode</h2>
 <div class="row">Файл или папка: <input id="path" size="55"> <button onclick="document.getElementById('path').value=getFile()">Файл…</button> <button onclick="chooseFolder()">Папка…</button></div>
 <div class="row">Кодировка: <select id="encoding"><option value="utf-8">UTF-8</option><option value="windows-1251">Windows-1251</option></select> <label><input id="recursive" type="checkbox" checked> рекурсивно</label></div>
 <div class="row"><label><input id="backup" type="checkbox" checked> создавать .bak</label> <label><input id="overwrite" type="checkbox"> заменять .bak</label> <label><input id="dryrun" type="checkbox"> только проверить</label> <label><input id="force" type="checkbox"> принудительно заменить непредставимые символы</label></div>
 <div class="row"><button id="start" onclick="process()">Перекодировать</button> <button id="cancel" disabled onclick="cancelled=true">Отменить отчёт</button> <button onclick="copyReport()">Копировать отчёт</button> <button onclick="saveReport()">Сохранить отчёт</button></div>
 <div id="current" class="warn"></div><h3>Отчёт</h3><div id="report"></div>
</body></html>
