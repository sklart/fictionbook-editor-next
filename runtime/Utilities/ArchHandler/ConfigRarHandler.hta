<!DOCTYPE html>
<html><head><title>Конфигуратор ArchHandler — RAR</title><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<script type="text/javascript">
var archiveType = "rar", archiveExtension = ".rar";
function error(message) { alert("Не удалось применить настройки.\n\n" + message); }
function value(id) { var e=document.getElementById(id); if (!e) throw new Error("Не найден элемент " + id); return e.value; }
function requireProgram(path, label, fso) { if (!path) throw new Error("Не выбран файл: " + label + "."); if (!fso.FileExists(path)) throw new Error("Файл не найден: " + path); if (fso.GetExtensionName(path).toLowerCase() !== "exe") throw new Error("Ожидается EXE-файл: " + path); }
function key(path) { return "HKCU\\Software\\FictionBook Editor\\ArchHandler\\" + archiveType + "\\" + path; }
function refreshShell(shell) { try { shell.Run("rundll32.exe shell32.dll,SHChangeNotify 0x08000000,0,0,0", 0, false); } catch (ignore) {} }
function deleteValue(shell, path) { try { shell.RegDelete(path); } catch (ignore) {} }
function deleteTree(shell, path) { try { shell.Run('reg.exe delete "'+path+'" /f', 0, true); } catch (ignore) {} }
function hasHandler(shell, type) { try { shell.RegRead("HKCU\\Software\\FictionBook Editor\\ArchHandler\\"+type+"\\Handler"); return true; } catch (ignore) { return false; } }
function loadSettings() { try { var o=new ActiveXObject("WScript.Shell"); document.getElementById("f1").value=o.RegRead(key("Handler")); document.getElementById("f2").value=o.RegRead(key("ArchiveProgram")); document.getElementById("t1").value=o.RegRead(key("ArchiveParameters")); document.getElementById("f3").value=o.RegRead(key("FB2Program")); document.getElementById("t2").value=o.RegRead(key("FB2Parameters")); } catch(ignore) {} }
function applySettings() { try { var fso=new ActiveXObject("Scripting.FileSystemObject"), o=new ActiveXObject("WScript.Shell"); var f1=value("f1"), f2=value("f2"), f3=value("f3"), t1=value("t1"), t2=value("t2"); requireProgram(f1,"ArchHandler",fso); requireProgram(f2,"обычный архиватор",fso); requireProgram(f3,"программа для FB2-архивов",fso); var progId="FictionBookEditor.ArchHandler."+archiveType, classes="HKCU\\Software\\Classes\\", command='"'+f1+'" --type '+archiveType+' "%1"'; o.RegWrite(key("Handler"),f1,"REG_SZ"); o.RegWrite(key("ArchiveProgram"),f2,"REG_SZ"); o.RegWrite(key("ArchiveParameters"),t1,"REG_SZ"); o.RegWrite(key("FB2Program"),f3,"REG_SZ"); o.RegWrite(key("FB2Parameters"),t2,"REG_SZ"); o.RegWrite(classes+progId+"\\", "FictionBook Editor ArchHandler ("+archiveType.toUpperCase()+")", "REG_SZ"); o.RegWrite(classes+progId+"\\DefaultIcon\\", '"'+f1+'",0', "REG_SZ"); o.RegWrite(classes+progId+"\\shell\\open\\command\\",command,"REG_SZ"); o.RegWrite(classes+archiveExtension+"\\OpenWithProgids\\"+progId,"","REG_SZ"); o.RegWrite("HKCU\\Software\\RegisteredApplications\\FictionBook Editor ArchHandler","Software\\FictionBook Editor\\ArchHandler\\Capabilities","REG_SZ"); o.RegWrite("HKCU\\Software\\FictionBook Editor\\ArchHandler\\Capabilities\\ApplicationName","FictionBook Editor ArchHandler","REG_SZ"); o.RegWrite("HKCU\\Software\\FictionBook Editor\\ArchHandler\\Capabilities\\FileAssociations\\"+archiveExtension,progId,"REG_SZ"); refreshShell(o); alert("Настройки успешно применены. Выберите ArchHandler в системных настройках приложений по умолчанию, если хотите назначить его обработчиком."); } catch(e) { error("Код: "+(e.number || "—")+"\nОписание: "+(e.description || e.message || e)); } }
function resetSettings() { try { var o=new ActiveXObject("WScript.Shell"), progId="FictionBookEditor.ArchHandler."+archiveType, classes="HKCU\\Software\\Classes\\", capabilities="HKCU\\Software\\FictionBook Editor\\ArchHandler\\Capabilities\\", otherType=archiveType==="rar" ? "zip" : "rar"; deleteTree(o,"HKCU\\Software\\FictionBook Editor\\ArchHandler\\"+archiveType); deleteValue(o,classes+archiveExtension+"\\OpenWithProgids\\"+progId); deleteTree(o,classes+progId); deleteValue(o,capabilities+"FileAssociations\\"+archiveExtension); if (!hasHandler(o,otherType)) { deleteValue(o,"HKCU\\Software\\RegisteredApplications\\FictionBook Editor ArchHandler"); deleteTree(o,capabilities); } refreshShell(o); alert("Конфигурация ArchHandler удалена. Текущий обработчик по умолчанию не изменён."); } catch(e) { error("Код: "+(e.number || "—")+"\nОписание: "+(e.description || e.message || e)); } }
window.onload=loadSettings;
</script></head><body style="font-family:tahoma;font-size:14px;padding:10px;margin:0"><p>ArchHandler для .rar и .fb2.rar. Конфигуратор регистрирует приложение, но не назначает его обработчиком по умолчанию.</p>ArchHandler.exe:<br><input type=file style="width:500px" id=f1><br><br>Программа для .rar:<br><input type=file style="width:500px" id=f2><br>Параметры (используйте $1 для пути к архиву):<br><input type=text style="width:500px" value='"$1"' id=t1><br><br>Программа для .fb2.rar:<br><input type=file style="width:500px" id=f3><br>Параметры (используйте $1 для пути к архиву):<br><input type=text style="width:500px" value='"$1"' id=t2><br><br><p style="text-align:center"><input type=button value="Применить" onclick="applySettings()"><input type=button value="Сбросить" onclick="resetSettings()"><input type=button value="Выйти" onclick="window.close()"></p></body></html>
