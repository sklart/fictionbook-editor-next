root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{c,cc,cpp,cxx,h,hpp,inl,ixx}]
charset = utf-8

[*.{ps1,psm1,psd1,bat,cmd}]
charset = utf-8-bom

[*.{rc,rc2}]
# Authored RC input is UTF-8 with BOM. Generated localization fragments retain
# their UTF-16LE producer format and are not hand edited.
charset = utf-8-bom

[src/**/generated/**]
generated_code = true
charset = unset
end_of_line = unset
insert_final_newline = unset

[src/fbe/generated/Fb2SchemaMetadata.h]
# This generated header is intentionally UTF-8 with LF line endings.
charset = utf-8
end_of_line = lf

[**/*.generated.rc2]
generated_code = true
# Generated localization fragments retain the producer's UTF-16LE format.
charset = unset
end_of_line = unset
insert_final_newline = unset

[src/export-docx/ExportDOCX_i.{c,h}]
generated_code = true
charset = unset
end_of_line = unset
insert_final_newline = unset

[src/export-epub/ExportEPUB_i.{c,h}]
generated_code = true
charset = unset
end_of_line = unset
insert_final_newline = unset

[third_party/**]
generated_code = true
charset = unset
end_of_line = unset
insert_final_newline = unset
