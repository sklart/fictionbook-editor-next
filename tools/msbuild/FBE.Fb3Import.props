<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)FBE.Fb3Package.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>LUNASVG_BUILD_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(FbeRepoRoot)\third_party\lunasvg\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FbeRepoRoot)\build\lib\lunasvg\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>lunasvg.lib;plutovg.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(FbeRepoRoot)\src\common\fb3\Fb3Import.cpp" />
  </ItemGroup>
</Project>
